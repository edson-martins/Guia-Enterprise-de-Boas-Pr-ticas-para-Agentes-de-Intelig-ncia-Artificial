{
  "name": "Guia Enterprise — 05b. Sub-Agente de Triagem (exemplo)",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [{ "name": "mensagem", "type": "string" }]
        }
      },
      "id": "n1-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-200, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{$json.mensagem}}",
        "options": {
          "systemMessage": "Classifique a mensagem do cliente em exatamente uma categoria: duvida, agendamento, suporte_tecnico, reclamacao ou outro. Responda APENAS em JSON no formato {\"categoria\": \"...\", \"resumo\": \"...\"}, sem texto adicional antes ou depois."
        }
      },
      "id": "n2-agent",
      "name": "AI Agent - Classificador",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [20, 300]
    },
    {
      "parameters": { "model": "claude-haiku-4-5-20251001", "options": { "temperature": 0 } },
      "id": "n3-model",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [0, 480]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [[{ "node": "AI Agent - Classificador", "type": "main", "index": 0 }]] },
    "Anthropic Chat Model": { "ai_languageModel": [[{ "node": "AI Agent - Classificador", "type": "ai_languageModel", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": {
    "note": "Este é o padrão base para replicar como agente_faq, agente_agendamento e agente_suporte_tecnico referenciados no workflow 05. Troque o systemMessage e o modelo de output conforme a especialidade de cada sub-agente."
  }
}
