{
  "name": "Guia Enterprise — 04. Handoff Humano (Redis TTL)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "handoff-humano",
        "responseMode": "responseNode",
        "options": {}
      },
