      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        240,
        640
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{$node[\"Normalizar Mensagem\"].json.chat_id}}",
        "contextWindowLength": 12
      },
      "id": "n11-memory",
      "name": "Memória da Conversa",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.2,
      "position": [
        360,
        640
      ]
    },
    {
      "parameters": {
        "name": "escalar_para_humano",
        "description": "Escala a conversa para um atendente humano. Use quando o cliente pedir explicitamente ou quando o assunto for sensível demais para a IA resolver.",
        "method": "POST",
        "url": "={{$env.N8N_BASE_URL}}/webhook/handoff-ativar",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"chat_id\": $node[\"Normalizar Mensagem\"].json.chat_id, \"motivo\": \"{motivo}\" } }}",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "motivo",
              "description": "Motivo breve da escalação",
              "type": "string"
            }
          ]
        }
      },
      "id": "n12-tool-escalar",
      "name": "escalar_para_humano",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        480,
        640
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WAHA_BASE_URL}}/api/sendText",
