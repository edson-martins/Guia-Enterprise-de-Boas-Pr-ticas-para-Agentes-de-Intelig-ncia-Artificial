        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.WAHA_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session\": $node[\"Normalizar Mensagem\"].json.session, \"chatId\": $node[\"Normalizar Mensagem\"].json.chat_id, \"text\": $json.output } }}",
        "options": {}
      },
