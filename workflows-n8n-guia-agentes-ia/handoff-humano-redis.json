      "id": "n6-redis-delete",
      "name": "Redis - Encerrar Modo Humano",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        500,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WAHA_BASE_URL}}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.WAHA_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session\": $node[\"Normalizar Mensagem\"].json.session, \"chatId\": $node[\"Normalizar Mensagem\"].json.chat_id, \"text\": \"Atendimento automático reativado. Como posso ajudar?\" } }}",
        "options": {}
      },
      "id": "n7-http-confirma-retorno",
      "name": "HTTP - WAHA Confirmar Retorno ao Agente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        140
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO execution_logs (workflow_name, event_type, level, message, chat_id)\nVALUES ('handoff-humano', 'mensagem_ignorada_modo_humano', 'info', 'Mensagem recebida durante atendimento humano, IA não respondeu', '{{$node[\"Normalizar Mensagem\"].json.chat_id}}')",
        "options": {}
      },
      "id": "n8-pg-log-ignorada",
      "name": "Postgres - Logar Mensagem Ignorada",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{$node[\"Normalizar Mensagem\"].json.texto}}",
        "options": {
          "systemMessage": "Você é a atendente virtual. Se em algum momento identificar que o cliente precisa falar com uma pessoa (reclamação, assunto financeiro sensível, pedido explícito de humano, ou situação que você não consegue resolver), chame a ferramenta escalar_para_humano em vez de tentar resolver sozinho."
        }
      },
      "id": "n9-agent",
      "name": "AI Agent - Atendente",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        280,
        460
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-5",
        "options": {
          "temperature": 0.4
        }
      },
