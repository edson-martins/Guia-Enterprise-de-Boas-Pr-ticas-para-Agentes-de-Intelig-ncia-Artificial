      "position": [
        -600,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "name": "chat_id",
              "type": "string",
              "value": "={{$json.body.payload.from}}"
            },
            {
              "name": "texto",
              "type": "string",
              "value": "={{$json.body.payload.body}}"
            },
            {
              "name": "session",
              "type": "string",
              "value": "={{$json.body.session}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n2-set",
      "name": "Normalizar Mensagem",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -380,
        300
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "key": "=handoff:{{$json.chat_id}}",
        "options": {}
      },
      "id": "n3-redis-get",
      "name": "Redis - Checar Modo Humano",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        -160,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{$json.propertyName}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n4-if-humano-ativo",
      "name": "IF - Modo Humano Ativo?",
