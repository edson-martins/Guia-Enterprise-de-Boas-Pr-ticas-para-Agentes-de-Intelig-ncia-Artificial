        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.WAHA_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session\": $env.WAHA_DEFAULT_SESSION, \"chatId\": $env.OPERATOR_WHATSAPP, \"text\": \"Novo handoff: \" + $json.body.chat_id + \" — motivo: \" + $json.body.motivo } }}",
        "options": {}
      },
      "id": "n16-http-notifica-operador",
