        -600,
        700
      ]
    },
    {
      "parameters": {
        "operation": "set",
        "key": "=handoff:{{$json.body.chat_id}}",
        "value": "={{$json.body.motivo}}",
        "expire": true,
        "ttl": 3600
      },
      "id": "n15-redis-set",
      "name": "Redis - Ativar Handoff (TTL 1h)",
      "type": "n8n-nodes-base.redis",
