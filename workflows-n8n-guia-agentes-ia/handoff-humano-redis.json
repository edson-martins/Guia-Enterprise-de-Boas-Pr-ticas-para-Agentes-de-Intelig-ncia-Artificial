      "typeVersion": 2.2,
      "position": [
        60,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{$node[\"Normalizar Mensagem\"].json.texto.trim()}}",
              "rightValue": "!encerrar",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n5-if-comando-encerrar",
      "name": "IF - Comando !encerrar?",
