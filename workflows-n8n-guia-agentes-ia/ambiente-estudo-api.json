      "position": [-600, 260]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO leads (chat_id, nome, empresa, cargo, necessidade, prazo)\nVALUES ('{{$json.body.chat_id}}', '{{$json.body.nome}}', '{{$json.body.empresa}}', '{{$json.body.cargo}}', '{{$json.body.necessidade}}', '{{$json.body.prazo}}')\nRETURNING id",
        "options": {}
      },
      "id": "n5-pg-lead",
      "name": "Postgres - Inserir Lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-380, 260]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"lead_id\": $json.id } }}",
        "options": {}
      },
      "id": "n6-respond-leads",
      "name": "Responder - Lead Salvo",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-160, 260]
    },

    {
