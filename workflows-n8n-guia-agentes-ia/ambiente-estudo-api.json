      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-600, 420]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO appointments (business_id, chat_id, patient_name, specialty, appointment_at, status)\nVALUES ({{$env.DEFAULT_BUSINESS_ID}}, '{{$json.body.chat_id}}', '{{$json.body.patient_name}}', '{{$json.body.specialty}}', '{{$json.body.appointment_at}}', 'agendado')\nRETURNING id, appointment_at",
        "options": {}
      },
      "id": "n8-pg-criar",
      "name": "Postgres - Criar Agendamento",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-380, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"appointment_id\": $json.id, \"appointment_at\": $json.appointment_at } }}",
        "options": {}
      },
      "id": "n9-respond-criar",
      "name": "Responder - Agendamento Criado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-160, 420]
    },

    {
      "parameters": {
        "httpMethod": "PATCH",
        "path": "appointments/cancel",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n10-webhook-cancelar",
      "name": "Webhook - PATCH appointments/cancel",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-600, 580]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE appointments\nSET status = 'cancelado'\nWHERE (\n  {{$json.body.appointment_id}}::text IS NOT NULL AND id = NULLIF('{{$json.body.appointment_id}}', '')::bigint\n) OR (\n  chat_id = '{{$json.body.chat_id}}' AND status = 'agendado'\n)\nRETURNING id",
        "options": {}
      },
      "id": "n11-pg-cancelar",
      "name": "Postgres - Cancelar Agendamento",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-380, 580]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"cancelados\": $input.all().map(i => i.json.id) } }}",
        "options": {}
      },
      "id": "n12-respond-cancelar",
      "name": "Responder - Agendamento Cancelado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-160, 580]
    }
