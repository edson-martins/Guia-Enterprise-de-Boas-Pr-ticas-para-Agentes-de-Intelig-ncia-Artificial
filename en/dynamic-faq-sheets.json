{
  "name": "Enterprise Guide — 03. Dynamic FAQ (Google Sheets)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "n1-schedule",
      "name": "Schedule - Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -400,
        200
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{$env.FAQ_SHEET_ID}}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "FAQ"
        },
        "options": {}
      },
      "id": "n2-sheets",
      "name": "Google Sheets - Read FAQ",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -180,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO faq (business_id, question, answer, category, updated_at)\nVALUES ({{$env.DEFAULT_BUSINESS_ID}}, '{{$json.question}}', '{{$json.answer}}', '{{$json.category}}', now())\nON CONFLICT (business_id, question) DO UPDATE\nSET answer = EXCLUDED.answer, category = EXCLUDED.category, updated_at = now()",
        "options": {}
      },
      "id": "n3-pg-upsert",
      "name": "Postgres - Upsert FAQ",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        40,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "faq-search",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n4-webhook",
      "name": "Webhook - Search FAQ (used as Tool)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        420
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT question, answer, category\nFROM faq\nWHERE business_id = {{$env.DEFAULT_BUSINESS_ID}}\n  AND (question ILIKE '%' || '{{$json.body.search_term}}' || '%'\n       OR answer ILIKE '%' || '{{$json.body.search_term}}' || '%')\nORDER BY updated_at DESC\nLIMIT 3",
        "options": {}
      },
      "id": "n5-pg-search",
      "name": "Postgres - Search FAQ by Term",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -180,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"results\": $input.all().map(item => item.json) } }}",
        "options": {}
      },
      "id": "n6-respond",
      "name": "Respond - FAQ Results",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        40,
        420
      ]
    }
  ],
  "connections": {
    "Schedule - Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Google Sheets - Read FAQ",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Read FAQ": {
      "main": [
        [
          {
            "node": "Postgres - Upsert FAQ",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook - Search FAQ (used as Tool)": {
      "main": [
        [
          {
            "node": "Postgres - Search FAQ by Term",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Search FAQ by Term": {
      "main": [
        [
          {
            "node": "Respond - FAQ Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}