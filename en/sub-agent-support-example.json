{
  "name": "Enterprise Guide — 05e. Technical Support Sub-Agent (example)",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "chat_id",
              "type": "string"
            },
            {
              "name": "problem",
              "type": "string"
            }
          ]
        }
      },
      "id": "n1-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{$json.problem}}",
        "options": {
          "systemMessage": "You are the Technical Support Agent. Help the customer solve common technical problems (access, product use, configuration questions) by asking diagnostic questions before suggesting a solution. If, after trying to diagnose it, the problem is not something you can solve in conversation (e.g. a confirmed bug, a need to access the customer's internal data, a billing issue), use the escalate_to_human tool and explain what has already been tried. Never promise a resolution time you cannot guarantee."
        }
      },
      "id": "n2-agent",
      "name": "AI Agent - Technical Support",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -180,
        300
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-5",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "n3-model",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        -220,
        500
      ]
    },
    {
      "parameters": {
        "name": "escalate_to_human",
        "description": "Escalates the technical problem to a human agent when it cannot be solved in conversation. Explain what has been diagnosed so far.",
        "method": "POST",
        "url": "={{$env.N8N_BASE_URL}}/webhook/handoff-activate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"chat_id\": $json.chat_id, \"reason\": $fromAI('reason', 'summary of the technical problem and of what has already been tried') } }}"
      },
      "id": "n4-tool-escalate",
      "name": "escalate_to_human",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        -60,
        500
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "AI Agent - Technical Support",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anthropic Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent - Technical Support",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "escalate_to_human": {
      "ai_tool": [
        [
          {
            "node": "AI Agent - Technical Support",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "note": "Reuses the /handoff-activate webhook from workflow 04 (human-handoff-redis.json) for escalation, so that workflow must be imported and active."
  }
}