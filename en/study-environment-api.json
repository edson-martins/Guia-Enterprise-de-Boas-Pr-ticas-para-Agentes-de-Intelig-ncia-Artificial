      "position": [
        -600,
        420
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO appointments (business_id, chat_id, patient_name, specialty, appointment_at, status)\nVALUES ({{$env.DEFAULT_BUSINESS_ID}}, '{{$json.body.chat_id}}', '{{$json.body.patient_name}}', '{{$json.body.specialty}}', '{{$json.body.appointment_at}}', 'scheduled')\nRETURNING id, appointment_at",
        "options": {}
      },
      "id": "n8-pg-create",
      "name": "Postgres - Create Appointment",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -380,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"appointment_id\": $json.id, \"appointment_at\": $json.appointment_at } }}",
        "options": {}
      },
      "id": "n9-respond-create",
      "name": "Respond - Appointment Created",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
