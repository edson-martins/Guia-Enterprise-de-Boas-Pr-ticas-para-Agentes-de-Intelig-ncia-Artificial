      "parameters": {
        "httpMethod": "PATCH",
        "path": "appointments/cancel",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n10-webhook-cancel",
      "name": "Webhook - PATCH appointments/cancel",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        580
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE appointments\nSET status = 'cancelled'\nWHERE (\n  {{$json.body.appointment_id}}::text IS NOT NULL AND id = NULLIF('{{$json.body.appointment_id}}', '')::bigint\n) OR (\n  chat_id = '{{$json.body.chat_id}}' AND status = 'scheduled'\n)\nRETURNING id",
        "options": {}
      },
      "id": "n11-pg-cancel",
      "name": "Postgres - Cancel Appointment",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -380,
        580
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"cancelled\": $input.all().map(i => i.json.id) } }}",
        "options": {}
      },
      "id": "n12-respond-cancel",
      "name": "Respond - Appointment Cancelled",
      "type": "n8n-nodes-base.respondToWebhook",
