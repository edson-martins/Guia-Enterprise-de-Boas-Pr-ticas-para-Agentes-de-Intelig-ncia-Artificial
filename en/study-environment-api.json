      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO leads (chat_id, name, company, job_title, need, deadline)\nVALUES ('{{$json.body.chat_id}}', '{{$json.body.name}}', '{{$json.body.company}}', '{{$json.body.job_title}}', '{{$json.body.need}}', '{{$json.body.deadline}}')\nRETURNING id",
        "options": {}
      },
