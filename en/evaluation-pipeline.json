{
  "name": "Enterprise Guide — 07. Evaluation Pipeline (Evals)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "n1-schedule",
      "name": "Schedule - Daily at 6 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT chat_id, business_id, array_agg(json_build_object('role', role, 'content', content) ORDER BY created_at) as messages\nFROM conversation_messages\nWHERE created_at >= now() - interval '1 day'\nGROUP BY chat_id, business_id",
        "options": {}
      },
      "id": "n2-pg-fetch-conversations",
      "name": "Postgres - Fetch Today's Conversations",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -180,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "n3-loop",
      "name": "Loop - One Conversation at a Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"claude-sonnet-5\",\n  \"max_tokens\": 500,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Evaluate this customer service conversation between an AI agent and a customer against these criteria: (1) it resolved the customer's request, (2) appropriate tone, (3) it did not make up information, (4) it escalated to a human when it should have. Give a score from 0 to 10 for each criterion and an overall score. Reply ONLY in JSON: {\\\"resolution\\\": N, \\\"tone\\\": N, \\\"accuracy\\\": N, \\\"appropriate_escalation\\\": N, \\\"overall_score\\\": N, \\\"justification\\\": \\\"...\\\"}.\\n\\nConversation:\\n\" + JSON.stringify($json.messages)\n  }]\n} }}",
        "options": {}
      },
      "id": "n4-http-claude-evaluate",
      "name": "HTTP - Claude Evaluate Conversation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        220
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "name": "evaluation",
              "type": "object",
              "value": "={{JSON.parse($json.content[0].text)}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n5-set-parse",
      "name": "Parse Evaluation",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        220
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO conversation_evals (chat_id, business_id, resolution, tone, accuracy, appropriate_escalation, overall_score, justification, evaluated_at)\nVALUES (\n  '{{$node[\"Loop - One Conversation at a Time\"].json.chat_id}}',\n  {{$node[\"Loop - One Conversation at a Time\"].json.business_id}},\n  {{$json.evaluation.resolution}},\n  {{$json.evaluation.tone}},\n  {{$json.evaluation.accuracy}},\n  {{$json.evaluation.appropriate_escalation}},\n  {{$json.evaluation.overall_score}},\n  '{{$json.evaluation.justification}}',\n  now()\n)",
        "options": {}
      },
      "id": "n6-pg-save-eval",
      "name": "Postgres - Save Evaluation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        700,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{$node[\"Parse Evaluation\"].json.evaluation.overall_score}}",
              "rightValue": 5,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n7-if-low-score",
      "name": "IF - Overall Score < 5?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WAHA_BASE_URL}}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.WAHA_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session\": $env.WAHA_DEFAULT_SESSION, \"chatId\": $env.OPERATOR_WHATSAPP, \"text\": \"⚠️ Low-scoring conversation (\" + $node[\"Parse Evaluation\"].json.evaluation.overall_score + \"/10): \" + $node[\"Loop - One Conversation at a Time\"].json.chat_id + \"\\nReason: \" + $node[\"Parse Evaluation\"].json.evaluation.justification } }}",
        "options": {}
      },
      "id": "n8-http-quality-alert",
      "name": "HTTP - Alert Low Quality",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        140
      ]
    }
  ],
  "connections": {
    "Schedule - Daily at 6 AM": {
      "main": [
        [
          {
            "node": "Postgres - Fetch Today's Conversations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Fetch Today's Conversations": {
      "main": [
        [
          {
            "node": "Loop - One Conversation at a Time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop - One Conversation at a Time": {
      "main": [
        [],
        [
          {
            "node": "HTTP - Claude Evaluate Conversation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Claude Evaluate Conversation": {
      "main": [
        [
          {
            "node": "Parse Evaluation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Evaluation": {
      "main": [
        [
          {
            "node": "Postgres - Save Evaluation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Save Evaluation": {
      "main": [
        [
          {
            "node": "IF - Overall Score < 5?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Overall Score < 5?": {
      "main": [
        [
          {
            "node": "HTTP - Alert Low Quality",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Loop - One Conversation at a Time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Alert Low Quality": {
      "main": [
        [
          {
            "node": "Loop - One Conversation at a Time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}