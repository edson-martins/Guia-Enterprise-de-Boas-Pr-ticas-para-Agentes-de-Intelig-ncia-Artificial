{
  "name": "Enterprise Guide — 04. Human Handoff (Redis TTL)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "human-handoff",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n1-webhook",
      "name": "Webhook - Message Received (WAHA)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "name": "chat_id",
              "type": "string",
              "value": "={{$json.body.payload.from}}"
            },
            {
              "name": "text",
              "type": "string",
              "value": "={{$json.body.payload.body}}"
            },
            {
              "name": "session",
              "type": "string",
              "value": "={{$json.body.session}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n2-set",
      "name": "Normalize Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -380,
        300
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "key": "=handoff:{{$json.chat_id}}",
        "options": {}
      },
      "id": "n3-redis-get",
      "name": "Redis - Check Human Mode",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        -160,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{$json.propertyName}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n4-if-human-active",
      "name": "IF - Human Mode Active?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        60,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{$node[\"Normalize Message\"].json.text.trim()}}",
              "rightValue": "!close",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n5-if-close-command",
      "name": "IF - !close Command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        280,
        200
      ]
    },
    {
      "parameters": {
        "operation": "delete",
        "key": "=handoff:{{$node[\"Normalize Message\"].json.chat_id}}"
      },
      "id": "n6-redis-delete",
      "name": "Redis - End Human Mode",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        500,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WAHA_BASE_URL}}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.WAHA_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session\": $node[\"Normalize Message\"].json.session, \"chatId\": $node[\"Normalize Message\"].json.chat_id, \"text\": \"Automated service is back on. How can I help?\" } }}",
        "options": {}
      },
      "id": "n7-http-confirm-return",
      "name": "HTTP - WAHA Confirm Return to Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        140
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO execution_logs (workflow_name, event_type, level, message, chat_id)\nVALUES ('human-handoff', 'message_ignored_human_mode', 'info', 'Message received during human service; the AI did not reply', '{{$node[\"Normalize Message\"].json.chat_id}}')",
        "options": {}
      },
      "id": "n8-pg-log-ignored",
      "name": "Postgres - Log Ignored Message",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{$node[\"Normalize Message\"].json.text}}",
        "options": {
          "systemMessage": "You are the virtual assistant. If at any point you see that the customer needs to talk to a person (a complaint, a sensitive financial matter, an explicit request for a human, or a situation you cannot resolve), call the escalate_to_human tool instead of trying to resolve it yourself."
        }
      },
      "id": "n9-agent",
      "name": "AI Agent - Assistant",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        280,
        460
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-5",
        "options": {
          "temperature": 0.4
        }
      },
      "id": "n10-model",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        240,
        640
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{$node[\"Normalize Message\"].json.chat_id}}",
        "contextWindowLength": 12
      },
      "id": "n11-memory",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.2,
      "position": [
        360,
        640
      ]
    },
    {
      "parameters": {
        "name": "escalate_to_human",
        "description": "Escalates the conversation to a human agent. Use it when the customer explicitly asks for one or when the matter is too sensitive for the AI to resolve.",
        "method": "POST",
        "url": "={{$env.N8N_BASE_URL}}/webhook/handoff-activate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"chat_id\": $node[\"Normalize Message\"].json.chat_id, \"reason\": \"{reason}\" } }}",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "reason",
              "description": "Brief reason for the escalation",
              "type": "string"
            }
          ]
        }
      },
      "id": "n12-tool-escalate",
      "name": "escalate_to_human",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        480,
        640
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WAHA_BASE_URL}}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.WAHA_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session\": $node[\"Normalize Message\"].json.session, \"chatId\": $node[\"Normalize Message\"].json.chat_id, \"text\": $json.output } }}",
        "options": {}
      },
      "id": "n13-http-waha",
      "name": "HTTP - WAHA Send Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        460
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "handoff-activate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n14-webhook-activate",
      "name": "Webhook - Activate Handoff (called by the Tool)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        700
      ]
    },
    {
      "parameters": {
        "operation": "set",
        "key": "=handoff:{{$json.body.chat_id}}",
        "value": "={{$json.body.reason}}",
        "expire": true,
        "ttl": 3600
      },
      "id": "n15-redis-set",
      "name": "Redis - Activate Handoff (TTL 1h)",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        -380,
        700
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WAHA_BASE_URL}}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.WAHA_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session\": $env.WAHA_DEFAULT_SESSION, \"chatId\": $env.OPERATOR_WHATSAPP, \"text\": \"New handoff: \" + $json.body.chat_id + \" — reason: \" + $json.body.reason } }}",
        "options": {}
      },
      "id": "n16-http-notify-operator",
      "name": "HTTP - Notify Operator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -160,
        700
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": {}
      },
      "id": "n17-respond-activate",
      "name": "Respond - Handoff Activated",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        60,
        700
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": {}
      },
      "id": "n18-respond-main",
      "name": "Respond to Main Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        920,
        300
      ]
    }
  ],
  "connections": {
