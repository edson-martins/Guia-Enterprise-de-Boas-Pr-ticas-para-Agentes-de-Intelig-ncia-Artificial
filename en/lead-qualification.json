          }
        ]
      ]
    },
    "Anthropic Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent - Qualifier",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Conversation Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent - Qualifier",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "save_lead": {
      "ai_tool": [
        [
          {
            "node": "AI Agent - Qualifier",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent - Qualifier": {
      "main": [
        [
          {
            "node": "HTTP - WAHA Send Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - WAHA Send Reply": {
      "main": [
        [
          {
