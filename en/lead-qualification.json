{
  "name": "Enterprise Guide — 02. Lead Qualification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-qualification",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n1-webhook",
      "name": "Webhook - Message Received (WAHA)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "name": "chat_id",
              "type": "string",
              "value": "={{$json.body.payload.from}}"
            },
            {
              "name": "text",
              "type": "string",
              "value": "={{$json.body.payload.body}}"
            },
            {
              "name": "session",
              "type": "string",
              "value": "={{$json.body.session}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n2-set",
      "name": "Normalize Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -180,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{$node[\"Normalize Message\"].json.text}}",
        "options": {
          "systemMessage": "You are a lead qualification assistant. Your only task is to collect, in a natural, conversational way (never like a form), these 5 fields: full name, company, job title, main need or pain point, and decision time frame (immediate/3 months/6 months/no deadline). Collect one or two fields at a time, never everything at once. When you have all 5 fields, call the save_lead tool with the structured data and thank the lead, saying that someone from the team will get back to them shortly. Never make up data the lead did not provide."
        }
      },
      "id": "n3-agent",
      "name": "AI Agent - Qualifier",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-5",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "n4-model",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        0,
        500
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{$node[\"Normalize Message\"].json.chat_id}}",
        "contextWindowLength": 20
      },
      "id": "n5-memory",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.2,
      "position": [
        120,
        500
      ]
    },
    {
      "parameters": {
        "name": "save_lead",
        "description": "Saves a qualified lead after the 5 required fields (name, company, job title, need, deadline) have been collected. Only call it when you have all 5.",
        "method": "POST",
        "url": "={{$env.API_BASE_URL}}/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.API_INTERNAL_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{$node[\\\"Normalize Message\\\"].json.chat_id}}\",\n  \"name\": \"{name}\",\n  \"company\": \"{company}\",\n  \"job_title\": \"{job_title}\",\n  \"need\": \"{need}\",\n  \"deadline\": \"{deadline}\"\n}",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "name",
              "description": "The lead's full name",
              "type": "string"
            },
            {
              "name": "company",
              "description": "The lead's company",
              "type": "string"
            },
            {
              "name": "job_title",
              "description": "The lead's job title at the company",
              "type": "string"
            },
            {
              "name": "need",
              "description": "Main need or pain point reported",
              "type": "string"
            },
            {
              "name": "deadline",
              "description": "Decision time frame: immediate, 3 months, 6 months or no deadline",
              "type": "string"
            }
          ]
        }
      },
      "id": "n6-tool-save",
      "name": "save_lead",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        240,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WAHA_BASE_URL}}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.WAHA_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session\": $node[\"Normalize Message\"].json.session, \"chatId\": $node[\"Normalize Message\"].json.chat_id, \"text\": $json.output } }}",
        "options": {}
      },
      "id": "n7-http-waha",
      "name": "HTTP - WAHA Send Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": {}
      },
      "id": "n8-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "Webhook - Message Received (WAHA)": {
      "main": [
        [
          {
            "node": "Normalize Message",
