{
  "name": "Enterprise Guide — 05d. Scheduling Sub-Agent (example)",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "chat_id",
              "type": "string"
            },
            {
              "name": "message",
              "type": "string"
            }
          ]
        }
      },
      "id": "n1-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{$json.message}}",
        "options": {
          "systemMessage": "You are the Scheduling Agent. You handle booking, rescheduling and cancelling appointments. Always use check_availability before confirming any new time slot. Never assume a slot is free. Once the customer has confirmed, use create_appointment (to book) or cancel_appointment (to cancel or reschedule, which means cancelling the old one and creating a new one). Never make up availability or confirm anything before actually checking."
        }
      },
      "id": "n2-agent",
      "name": "AI Agent - Scheduling",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -180,
        300
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-5",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "n3-model",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        -260,
        500
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{$json.chat_id}}",
        "contextWindowLength": 8
      },
      "id": "n4-memory",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.2,
      "position": [
        -140,
        500
      ]
    },
    {
      "parameters": {
        "name": "check_availability",
        "description": "Looks up free time slots in a calendar for a specific date. Use it before proposing or confirming any time slot.",
        "method": "POST",
        "url": "={{$env.N8N_BASE_URL}}/webhook/freebusy-check",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"calendar_id\": $env.DEFAULT_CALENDAR_ID, \"date\": $fromAI('date', 'date in YYYY-MM-DD format') } }}"
      },
      "id": "n5-tool-availability",
      "name": "check_availability",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        20,
        500
      ]
    },
    {
      "parameters": {
        "name": "create_appointment",
        "description": "Creates a new appointment after the customer has confirmed the date and time and availability has been checked.",
        "method": "POST",
        "url": "={{$env.API_BASE_URL}}/appointments",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.API_INTERNAL_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"chat_id\": $json.chat_id,\n  \"patient_name\": $fromAI('patient_name', 'patient name'),\n  \"appointment_at\": $fromAI('date_time', 'date and time in ISO 8601 format'),\n  \"specialty\": $fromAI('specialty', 'requested specialty or service')\n} }}"
      },
      "id": "n6-tool-create",
      "name": "create_appointment",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        160,
        500
      ]
    },
    {
      "parameters": {
        "name": "cancel_appointment",
        "description": "Cancels an existing appointment. Use it both for a permanent cancellation and as the first step of a reschedule.",
        "method": "PATCH",
        "url": "={{$env.API_BASE_URL}}/appointments/cancel",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.API_INTERNAL_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"chat_id\": $json.chat_id, \"appointment_id\": $fromAI('appointment_id', 'ID of the appointment to cancel, if known; otherwise leave empty') } }}"
      },
      "id": "n7-tool-cancel",
      "name": "cancel_appointment",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        300,
        500
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "AI Agent - Scheduling",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anthropic Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent - Scheduling",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Conversation Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent - Scheduling",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "check_availability": {
      "ai_tool": [
        [
          {
            "node": "AI Agent - Scheduling",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "create_appointment": {
      "ai_tool": [
        [
          {
            "node": "AI Agent - Scheduling",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "cancel_appointment": {
      "ai_tool": [
        [
          {
            "node": "AI Agent - Scheduling",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "note": "Depends on workflow 09 (freebusy-cache.json) for the availability lookup. The /appointments and /appointments/cancel routes belong to your internal API (the same one used by workflows 01/02). Adapt the field names to your real schema."
  }
}