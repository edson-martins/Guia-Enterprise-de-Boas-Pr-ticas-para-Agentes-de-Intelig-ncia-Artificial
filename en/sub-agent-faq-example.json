{
  "name": "Enterprise Guide — 05c. FAQ Sub-Agent (example)",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "question",
              "type": "string"
            }
          ]
        }
      },
      "id": "n1-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{$json.question}}",
        "options": {
          "systemMessage": "You are the FAQ Agent. Answer the customer's general questions using only the search_faq tool. Never make up an answer that did not come from the FAQ base. If the search returns nothing relevant, say clearly that you did not find that information and suggest that the Manager Agent escalate to a human. Answer directly, in 1 to 3 sentences."
        }
      },
      "id": "n2-agent",
      "name": "AI Agent - FAQ",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -180,
        300
      ]
    },
    {
      "parameters": {
        "model": "claude-haiku-4-5-20251001",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "n3-model",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        -220,
        480
      ]
    },
    {
      "parameters": {
        "name": "search_faq",
        "description": "Searches the frequently asked questions base for a term. Use the most relevant keywords from the customer's question.",
        "method": "POST",
        "url": "={{$env.N8N_BASE_URL}}/webhook/faq-search",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"search_term\": $fromAI('search_term', 'keywords from the customer question') } }}"
      },
      "id": "n4-tool-faq",
      "name": "search_faq",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        -60,
        480
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "AI Agent - FAQ",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anthropic Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent - FAQ",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "search_faq": {
      "ai_tool": [
        [
          {
            "node": "AI Agent - FAQ",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "note": "Requires workflow 03 (dynamic-faq-sheets.json) to be imported and active, since it calls that workflow's /faq-search webhook. It uses Haiku because this is a simple lookup task. See section 4.2 on layered model architecture."
  }
}