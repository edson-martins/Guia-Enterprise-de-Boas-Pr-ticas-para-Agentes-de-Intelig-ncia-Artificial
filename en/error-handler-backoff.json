{
  "name": "Enterprise Guide — 06. Error Handler with Backoff",
  "nodes": [
    {
      "parameters": {},
      "id": "n1-error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "name": "failed_workflow",
              "type": "string",
              "value": "={{$json.workflow.name}}"
            },
            {
              "name": "execution_id",
              "type": "string",
              "value": "={{$json.execution.id}}"
            },
            {
              "name": "error_message",
              "type": "string",
              "value": "={{$json.execution.error.message}}"
            },
            {
              "name": "failed_node",
              "type": "string",
              "value": "={{$json.execution.error.node.name}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n2-set",
      "name": "Extract Error Details",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -180,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT count(*) as attempts FROM execution_logs\nWHERE workflow_name = '{{$json.failed_workflow}}'\n  AND event_type = 'automatic_retry'\n  AND created_at > now() - interval '1 hour'",
        "options": {}
      },
      "id": "n3-pg-count-attempts",
      "name": "Postgres - Count Recent Attempts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{$json.attempts}}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n4-if-can-retry",
      "name": "IF - Attempts < 3?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "amount": "={{ Math.pow(2, $json.attempts) * 30 + Math.floor(Math.random() * 10) }}",
        "unit": "seconds"
      },
      "id": "n5-wait-backoff",
      "name": "Wait - Exponential Backoff",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        480,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.N8N_API_BASE_URL}}/executions/{{$node[\"Extract Error Details\"].json.execution_id}}/retry",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "={{$env.N8N_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n6-http-retry",
      "name": "HTTP - Re-run Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        220
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO execution_logs (workflow_name, event_type, level, message)\nVALUES ('{{$node[\"Extract Error Details\"].json.failed_workflow}}', 'automatic_retry', 'warning', 'Automatic retry after failure: {{$node[\"Extract Error Details\"].json.error_message}}')",
        "options": {}
      },
      "id": "n7-pg-log-retry",
      "name": "Postgres - Retry Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        920,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WAHA_BASE_URL}}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.WAHA_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session\": $env.WAHA_DEFAULT_SESSION, \"chatId\": $env.OPERATOR_WHATSAPP, \"text\": \"🔴 Workflow \" + $node[\"Extract Error Details\"].json.failed_workflow + \" failed 3 times and stopped retrying on its own.\\n\\nError: \" + $node[\"Extract Error Details\"].json.error_message + \"\\nNode: \" + $node[\"Extract Error Details\"].json.failed_node + \"\\nExecution: \" + $node[\"Extract Error Details\"].json.execution_id } }}",
        "options": {}
      },
      "id": "n8-http-alert",
      "name": "HTTP - Alert Operator (WAHA)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        420
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO execution_logs (workflow_name, event_type, level, message)\nVALUES ('{{$node[\"Extract Error Details\"].json.failed_workflow}}', 'permanent_failure', 'error', 'Automatic retries exhausted: {{$node[\"Extract Error Details\"].json.error_message}}')",
        "options": {}
      },
      "id": "n9-pg-log-failure",
      "name": "Postgres - Permanent Failure Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        700,
        420
      ]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Extract Error Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Error Details": {
      "main": [
        [
          {
            "node": "Postgres - Count Recent Attempts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Count Recent Attempts": {
      "main": [
        [
          {
            "node": "IF - Attempts < 3?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Attempts < 3?": {
      "main": [
        [
          {
            "node": "Wait - Exponential Backoff",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "HTTP - Alert Operator (WAHA)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait - Exponential Backoff": {
      "main": [
        [
          {
            "node": "HTTP - Re-run Workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Re-run Workflow": {
      "main": [
        [
          {
            "node": "Postgres - Retry Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Alert Operator (WAHA)": {
      "main": [
        [
          {
            "node": "Postgres - Permanent Failure Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "note": "Set this workflow as the 'Error Workflow' in the settings of any other workflow (Settings > Error Workflow) so that it fires automatically when that workflow fails."
  }
}